{{ 'cathora-v9.css' | asset_url | stylesheet_tag }}
<style>:root{--paper:{{ settings.paper }};--ink:{{ settings.ink }}}</style><script src="{{ 'cathora-shopify.js' | asset_url }}" defer></script><script src="{{ 'cathora-v9.js' | asset_url }}" defer></script></head><body class="v9"><a class="skip" href="#main">{{ 'cathora.continue' | t }}</a>{% if settings.show_announcement %}<div class="preview"><span>{{ settings.announcement | escape }}</span><span>CATHORA</span></div>{% endif %}{% section 'v9-header' %}<main id="main" tabindex="-1">{{ content_for_layout }}</main>{% section 'v9-footer' %}<dialog id="cathora-image-dialog" class="info-dialog cathora-image-dialog" aria-label="{{ 'cathora.details' | t }}"><button type="button" class="close" data-close-image aria-label="Close">×</button><div data-image-content></div></dialog></body></html>
