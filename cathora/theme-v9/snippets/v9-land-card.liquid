{%- case land -%}{%- when 'putuo' -%}{%- assign la_bg = "#E7EAEA" -%}{%- assign la_fg = "#2F3B45" -%}{%- assign la_p1 = "M86 140 C104 104 146 96 176 140" -%}{%- assign la_p2 = "M24 156 C54 148 74 164 104 156 C134 148 154 164 184 156 C214 148 234 164 258 156" -%}{%- assign la_cx = 196 -%}{%- assign la_cy = 92 -%}{%- assign la_zh = "普陀" -%}{%- assign la_roman = "Putuo" -%}{%- when 'lingyin' -%}{%- assign la_bg = "#ECE9E1" -%}{%- assign la_fg = "#272B24" -%}{%- assign la_p1 = "M56 128 L116 54 L144 88 L170 62 L228 128" -%}{%- assign la_p2 = "M34 152 C80 142 122 162 164 150 C206 140 236 156 258 148" -%}{%- assign la_cx = 210 -%}{%- assign la_cy = 52 -%}{%- assign la_zh = "灵隐" -%}{%- assign la_roman = "Lingyin" -%}{%- when 'jingshan' -%}{%- assign la_bg = "#EDE7DA" -%}{%- assign la_fg = "#5A4A3A" -%}{%- assign la_p1 = "M98 120 C98 160 182 160 182 120 Z" -%}{%- assign la_p2 = "M20 98 C70 72 110 86 150 62 C190 42 230 72 262 60" -%}{%- assign la_cx = 74 -%}{%- assign la_cy = 64 -%}{%- assign la_zh = "径山" -%}{%- assign la_roman = "Jingshan" -%}{%- when 'tiantai' -%}{%- assign la_bg = "#E4E2DA" -%}{%- assign la_fg = "#3E413A" -%}{%- assign la_p1 = "M40 148 L40 112 L92 112 L92 88 L146 88 L146 64 L208 64 L208 148" -%}{%- assign la_p2 = "M22 102 C62 92 92 106 130 98 C168 90 200 102 244 94" -%}{%- assign la_cx = 232 -%}{%- assign la_cy = 48 -%}{%- assign la_zh = "天台" -%}{%- assign la_roman = "Tiantai" -%}{%- when 'emei' -%}{%- assign la_bg = "#EFE9DC" -%}{%- assign la_fg = "#7A5A2E" -%}{%- assign la_p1 = "M40 138 C80 120 104 70 140 58 C176 70 200 120 240 138" -%}{%- assign la_p2 = "M20 160 C70 150 110 166 150 158 C190 150 228 162 262 156" -%}{%- assign la_cx = 140 -%}{%- assign la_cy = 30 -%}{%- assign la_zh = "峨眉" -%}{%- assign la_roman = "Emei" -%}{%- endcase -%}{%- capture lnum -%}{{ 'v9.lands.' | append: land | append: '.num' | t }}{%- endcapture -%}
<a class="v9-land" href="{{ routes.collections_url }}/{{ land }}">
<span class="v9-land-art{% if wide %} wide{% endif %}" style="background:{{ la_bg }}">{% unless wide %}<span class="v9-land-chap" style="color:{{ la_fg }}">{{ 'v9.ui.chapter' | t: n: lnum }}</span><span class="v9-land-vert" aria-hidden="true" style="color:{{ la_fg }}">{{ la_zh }}</span>{% endunless %}<svg viewBox="0 0 280 200" aria-hidden="true" focusable="false"><path d="{{ la_p1 }}" fill="none" stroke="{{ la_fg }}" stroke-width="{{ sw1 | default: 1.6 }}" stroke-linecap="round" stroke-linejoin="round"></path><path d="{{ la_p2 }}" fill="none" stroke="{{ la_fg }}" stroke-width="{{ sw2 | default: 1.1 }}" stroke-linecap="round" opacity="0.65"></path><circle cx="{{ la_cx }}" cy="{{ la_cy }}" r="4.5" fill="{{ la_fg }}"></circle></svg></span>
<span class="v9-land-txt"><span class="v9-land-name"><span class="z">{{ la_zh }}</span><span class="r">{{ la_roman }}</span></span>
<span class="v9-land-sub">{{ 'v9.lands.' | append: land | append: '.subtitle' | t }}</span>
{% unless wide %}<span class="v9-land-leg">{{ 'v9.lands.' | append: land | append: '.legend' | t }}</span><span class="v9-land-enter">{{ 'v9.ui.enter' | t }} →</span>{% endunless %}</span>
</a>