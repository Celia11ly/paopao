{% form 'localization', id: fid, class: 'v9-loc' %}{% if localization.available_languages.size > 1 %}<label><span class="v9-sr">{{ 'cathora.language' | t }}</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg><select name="locale_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>{% endfor %}</select></label>{% endif %}{% if localization.available_countries.size > 1 %}<label><span class="v9-sr">{{ 'cathora.country' | t }}</span><select name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} · {{ country.currency.iso_code }}</option>{% endfor %}</select></label>{% endif %}<noscript><button type="submit">→</button></noscript>{% endform %}