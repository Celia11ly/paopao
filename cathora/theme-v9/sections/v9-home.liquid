<div class="v9">
{%- assign hero = section.settings.hero_product | default: all_products['enduring-form'] -%}
<section class="v9-wrap v9-hero" aria-labelledby="v9-hero-h"><div style="max-width:540px">
<p class="v9-eyebrow" style="margin-bottom:26px">{{ 'v9.ui.eyebrow' | t }}</p>
<h1 id="v9-hero-h" class="v9-h1 v9-pre">{{ 'v9.ui.h1' | t }}</h1>
<p class="v9-lede">{{ 'v9.ui.lede' | t }}</p>
<div class="v9-cta"><a class="v9-btn" href="#lands">{{ 'v9.ui.cta1' | t }} <span aria-hidden="true">→</span></a><a class="v9-link" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.ui.cta2' | t }}</a></div></div>
{% if hero != blank %}<figure class="v9-figure"><a class="v9-square" href="{{ hero.url }}">{{ hero.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: hero.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '600,900,1200,1400' }}</a>
<figcaption class="v9-figcap"><span>{{ hero.title | escape }}</span><span>{{ hero.price | money }} ↗</span></figcaption></figure>{% endif %}
</section>
<nav class="v9-ways" aria-label="{{ 'v9.ui.nav0' | t }}"><div class="v9-wrap"><a class="v9-way" href="#lands"><span class="v9-way-num">01</span><span class="v9-way-t"><b>{{ 'v9.ways.w1.title' | t }}</b><i aria-hidden="true">{{ 'v9.ways.w1.sub' | t }}</i></span><span class="v9-way-l">{{ 'v9.ways.w1.line' | t }}</span><span class="v9-way-arrow" aria-hidden="true">↗</span></a><a class="v9-way" href="#intent"><span class="v9-way-num">02</span><span class="v9-way-t"><b>{{ 'v9.ways.w2.title' | t }}</b><i aria-hidden="true">{{ 'v9.ways.w2.sub' | t }}</i></span><span class="v9-way-l">{{ 'v9.ways.w2.line' | t }}</span><span class="v9-way-arrow" aria-hidden="true">↗</span></a><a class="v9-way" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements"><span class="v9-way-num">03</span><span class="v9-way-t"><b>{{ 'v9.ways.w3.title' | t }}</b><i aria-hidden="true">{{ 'v9.ways.w3.sub' | t }}</i></span><span class="v9-way-l">{{ 'v9.ways.w3.line' | t }}</span><span class="v9-way-arrow" aria-hidden="true">↗</span></a><a class="v9-way" href="{{ routes.collections_url }}/everyday"><span class="v9-way-num">04</span><span class="v9-way-t"><b>{{ 'v9.ways.w4.title' | t }}</b><i aria-hidden="true">{{ 'v9.ways.w4.sub' | t }}</i></span><span class="v9-way-l">{{ 'v9.ways.w4.line' | t }}</span><span class="v9-way-arrow" aria-hidden="true">↗</span></a></div></nav>
<section id="lands" class="v9-wrap v9-sec" aria-labelledby="v9-lands-h">
<div class="v9-sec-head"><div><p class="v9-eyebrow red">{{ 'v9.ui.landsEyebrow' | t }}</p><h2 id="v9-lands-h" class="v9-h2 v9-pre">{{ 'v9.ui.landsH' | t }}</h2></div><p class="v9-p">{{ 'v9.ui.landsP' | t }}</p></div>
<div class="v9-lands">{% render 'v9-land-card', land: 'putuo' %}{% render 'v9-land-card', land: 'lingyin' %}{% render 'v9-land-card', land: 'jingshan' %}{% render 'v9-land-card', land: 'tiantai' %}{% render 'v9-land-card', land: 'emei' %}</div></section>
<section id="pieces" class="v9-border-top" aria-labelledby="v9-pieces-h"><div class="v9-wrap v9-sec" style="padding-top:96px">
<div class="v9-row-head"><h2 id="v9-pieces-h" class="v9-h2">{{ 'v9.ui.piecesH' | t }}</h2><a class="v9-ul" href="{{ routes.all_products_collection_url }}">{{ 'v9.ui.piecesLink' | t }}</a></div>
<div class="v9-grid">{% assign rec = section.settings.featured_collection | default: collections.all %}{% for card_product in rec.products limit: 8 %}{% render 'v9-card', card_product: card_product %}{% endfor %}</div></div></section>
<section id="intent" class="v9-tint" aria-labelledby="v9-intent-h"><div class="v9-wrap" style="padding-top:96px;padding-bottom:96px">
<div style="text-align:center;margin-bottom:52px"><p class="v9-eyebrow" style="margin-bottom:16px">{{ 'v9.ui.intentEyebrow' | t }}</p><h2 id="v9-intent-h" class="v9-h2" style="font-size:clamp(32px,3.8vw,44px)">{{ 'v9.ui.intentH' | t }}</h2></div>
<div class="v9-intents"><a class="v9-intent" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}collections/putuo"><span class="c" aria-hidden="true">{{ 'v9.intent.i1.char' | t }}</span><span class="n">{{ 'v9.intent.i1.name' | t }}</span><span class="l">{{ 'v9.intent.i1.line' | t }}</span></a><a class="v9-intent" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}collections/jingshan"><span class="c" aria-hidden="true">{{ 'v9.intent.i2.char' | t }}</span><span class="n">{{ 'v9.intent.i2.name' | t }}</span><span class="l">{{ 'v9.intent.i2.line' | t }}</span></a><a class="v9-intent" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}collections/lingyin"><span class="c" aria-hidden="true">{{ 'v9.intent.i3.char' | t }}</span><span class="n">{{ 'v9.intent.i3.name' | t }}</span><span class="l">{{ 'v9.intent.i3.line' | t }}</span></a><a class="v9-intent" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}collections/gifting"><span class="c" aria-hidden="true">{{ 'v9.intent.i4.char' | t }}</span><span class="n">{{ 'v9.intent.i4.name' | t }}</span><span class="l">{{ 'v9.intent.i4.line' | t }}</span></a><a class="v9-intent" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}collections/emei"><span class="c" aria-hidden="true">{{ 'v9.intent.i5.char' | t }}</span><span class="n">{{ 'v9.intent.i5.name' | t }}</span><span class="l">{{ 'v9.intent.i5.line' | t }}</span></a><a class="v9-intent" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}collections/tiantai"><span class="c" aria-hidden="true">{{ 'v9.intent.i6.char' | t }}</span><span class="n">{{ 'v9.intent.i6.name' | t }}</span><span class="l">{{ 'v9.intent.i6.line' | t }}</span></a></div></div></section>
<section id="elements" class="v9-wrap v9-sec" aria-labelledby="v9-el-h"><div class="v9-two"><div style="max-width:500px">
<p class="v9-eyebrow red">{{ 'v9.ui.elEyebrow' | t }}</p><h2 id="v9-el-h" class="v9-h2 v9-pre">{{ 'v9.ui.elH' | t }}</h2><p class="v9-p" style="margin:26px 0 0">{{ 'v9.ui.elP' | t }}</p>
<a class="v9-btn" style="margin-top:34px" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.ui.elCta' | t }} <span aria-hidden="true">→</span></a></div>
<div class="v9-el-grid"><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#wood"><span class="o" aria-hidden="true" style="color:#56634A">木</span><span class="n">{{ 'v9.el.wood.name' | t }}</span><span class="l">{{ 'v9.el.wood.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#fire"><span class="o" aria-hidden="true" style="color:#9E3B2C">火</span><span class="n">{{ 'v9.el.fire.name' | t }}</span><span class="l">{{ 'v9.el.fire.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#earth"><span class="o" aria-hidden="true" style="color:#8C6A43">土</span><span class="n">{{ 'v9.el.earth.name' | t }}</span><span class="l">{{ 'v9.el.earth.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#metal"><span class="o" aria-hidden="true" style="color:#6E6C66">金</span><span class="n">{{ 'v9.el.metal.name' | t }}</span><span class="l">{{ 'v9.el.metal.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#water"><span class="o" aria-hidden="true" style="color:#2F3B45">水</span><span class="n">{{ 'v9.el.water.name' | t }}</span><span class="l">{{ 'v9.el.water.line' | t }}</span></a></div></div></section>
<section id="story" class="v9-border-top" aria-labelledby="v9-story-h"><div class="v9-wrap v9-sec"><div class="v9-two" style="gap:72px">
<div class="v9-story-art"><img src="{{ 'cathora-mark.png' | asset_url }}" alt="" loading="lazy"></div>
<div style="max-width:540px"><p class="v9-eyebrow">{{ 'v9.ui.storyEyebrow' | t }}</p><h2 id="v9-story-h" class="v9-h2 v9-pre" style="font-size:clamp(32px,3.8vw,44px);line-height:1.14">{{ 'v9.ui.storyH' | t }}</h2>
<p class="v9-serif-p" style="margin:26px 0 0">{{ 'v9.ui.story1' | t }}</p><p class="v9-serif-p" style="margin:16px 0 0">{{ 'v9.ui.story2' | t }}</p>
<div style="display:flex;flex-wrap:wrap;gap:28px;margin-top:36px"><a class="v9-ul" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/brand">{{ 'v9.ui.storyL1' | t }}</a><a class="v9-ul" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/founder">{{ 'v9.ui.storyL2' | t }}</a></div></div></div></div></section>
<section class="v9-tint v9-promises" aria-label="CATHORA"><div class="v9-wrap"><div class="v9-promise"><b>{{ 'v9.promise.p1.title' | t }}</b><span>{{ 'v9.promise.p1.line' | t }}</span></div><div class="v9-promise"><b>{{ 'v9.promise.p2.title' | t }}</b><span>{{ 'v9.promise.p2.line' | t }}</span></div><div class="v9-promise"><b>{{ 'v9.promise.p3.title' | t }}</b><span>{{ 'v9.promise.p3.line' | t }}</span></div></div></section>
<section class="v9-news" aria-labelledby="v9-news-h"><div class="v9-news-in"><h2 id="v9-news-h" class="v9-h2" style="font-size:36px">{{ 'v9.ui.newsH' | t }}</h2><p class="v9-p" style="margin:14px 0 0">{{ 'v9.ui.newsP' | t }}</p>{% render 'v9-newsletter', id: 'v9-news-home' %}</div></section>
</div>
{% schema %}{"name":"CATHORA v9 home","settings":[{"type":"product","id":"hero_product","label":"Hero product / 主推商品"},{"type":"collection","id":"featured_collection","label":"Featured collection / 推荐系列"}],"presets":[{"name":"CATHORA v9 home"}]}{% endschema %}