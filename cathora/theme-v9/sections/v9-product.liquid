{%- assign pland = '' -%}{%- assign pel = '' -%}
{%- for c in product.collections -%}{%- case c.handle -%}{%- when 'putuo' -%}{%- assign pland = 'putuo' -%}{%- when 'lingyin' -%}{%- assign pland = 'lingyin' -%}{%- when 'jingshan' -%}{%- assign pland = 'jingshan' -%}{%- when 'tiantai' -%}{%- assign pland = 'tiantai' -%}{%- when 'emei' -%}{%- assign pland = 'emei' -%}{%- when 'element-wood' -%}{%- assign pel = 'wood' -%}{%- when 'fire' -%}{%- assign pel = 'fire' -%}{%- when 'earth' -%}{%- assign pel = 'earth' -%}{%- when 'metal' -%}{%- assign pel = 'metal' -%}{%- when 'water' -%}{%- assign pel = 'water' -%}{%- endcase -%}{%- endfor -%}
{%- assign current = product.selected_or_first_available_variant -%}
<script type="application/ld+json">{{ product | structured_data }}</script>
<div class="v9">
<nav class="v9-wrap v9-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'v9.ui.crumbHome' | t }}</a><span aria-hidden="true">/</span>
{%- if pland != '' -%}{%- case pland -%}{%- when 'putuo' -%}{%- assign la_bg = "#E7EAEA" -%}{%- assign la_fg = "#2F3B45" -%}{%- assign la_p1 = "M86 140 C104 104 146 96 176 140" -%}{%- assign la_p2 = "M24 156 C54 148 74 164 104 156 C134 148 154 164 184 156 C214 148 234 164 258 156" -%}{%- assign la_cx = 196 -%}{%- assign la_cy = 92 -%}{%- assign la_zh = "普陀" -%}{%- assign la_roman = "Putuo" -%}{%- when 'lingyin' -%}{%- assign la_bg = "#ECE9E1" -%}{%- assign la_fg = "#272B24" -%}{%- assign la_p1 = "M56 128 L116 54 L144 88 L170 62 L228 128" -%}{%- assign la_p2 = "M34 152 C80 142 122 162 164 150 C206 140 236 156 258 148" -%}{%- assign la_cx = 210 -%}{%- assign la_cy = 52 -%}{%- assign la_zh = "灵隐" -%}{%- assign la_roman = "Lingyin" -%}{%- when 'jingshan' -%}{%- assign la_bg = "#EDE7DA" -%}{%- assign la_fg = "#5A4A3A" -%}{%- assign la_p1 = "M98 120 C98 160 182 160 182 120 Z" -%}{%- assign la_p2 = "M20 98 C70 72 110 86 150 62 C190 42 230 72 262 60" -%}{%- assign la_cx = 74 -%}{%- assign la_cy = 64 -%}{%- assign la_zh = "径山" -%}{%- assign la_roman = "Jingshan" -%}{%- when 'tiantai' -%}{%- assign la_bg = "#E4E2DA" -%}{%- assign la_fg = "#3E413A" -%}{%- assign la_p1 = "M40 148 L40 112 L92 112 L92 88 L146 88 L146 64 L208 64 L208 148" -%}{%- assign la_p2 = "M22 102 C62 92 92 106 130 98 C168 90 200 102 244 94" -%}{%- assign la_cx = 232 -%}{%- assign la_cy = 48 -%}{%- assign la_zh = "天台" -%}{%- assign la_roman = "Tiantai" -%}{%- when 'emei' -%}{%- assign la_bg = "#EFE9DC" -%}{%- assign la_fg = "#7A5A2E" -%}{%- assign la_p1 = "M40 138 C80 120 104 70 140 58 C176 70 200 120 240 138" -%}{%- assign la_p2 = "M20 160 C70 150 110 166 150 158 C190 150 228 162 262 156" -%}{%- assign la_cx = 140 -%}{%- assign la_cy = 30 -%}{%- assign la_zh = "峨眉" -%}{%- assign la_roman = "Emei" -%}{%- endcase -%}<a href="{{ routes.collections_url }}/{{ pland }}">{{ la_zh }} {{ la_roman }}</a>{%- else -%}<a href="{{ routes.all_products_collection_url }}">{{ 'v9.ui.allPieces' | t }}</a>{%- endif -%}
<span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span></nav>
<section class="v9-wrap v9-pp" aria-labelledby="v9-pp-h">
<div class="v9-gallery" data-v9-gallery>
<div class="v9-square">{%- assign fm = current.featured_media | default: product.featured_media -%}{% if fm %}{{ fm | image_url: width: 1400 | image_tag: class: 'v9-main', loading: 'eager', fetchpriority: 'high', alt: product.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '600,900,1200,1400' }}{% endif %}</div>
{% if product.media.size > 1 %}<div class="v9-thumbs">{% for m in product.media %}{% if m.media_type == 'image' %}<button type="button" data-v9-thumb data-src="{{ m | image_url: width: 1400 }}" aria-current="{% if m.id == fm.id %}true{% else %}false{% endif %}" aria-label="{{ 'v9.pp.image' | t }} {{ forloop.index }}">{{ m | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}</button>{% endif %}{% endfor %}</div>{% endif %}
</div>
<div style="max-width:540px">
<div class="v9-tags">{% if pland != '' %}<a href="{{ routes.collections_url }}/{{ pland }}">{{ 'v9.pp.land' | t }} · {{ la_zh }} {{ la_roman }}</a>{% endif %}{% if pel != '' %}<a href="{{ routes.collections_url }}/{% case pel %}{% when 'wood' %}element-wood{% when 'fire' %}fire{% when 'earth' %}earth{% when 'metal' %}metal{% when 'water' %}water{% endcase %}">{{ 'v9.pp.element' | t }} · {{ 'v9.el.' | append: pel | append: '.name' | t }}</a>{% endif %}</div>
<h1 id="v9-pp-h" class="v9-h1 v9-pp-title">{{ product.title | escape }}</h1>
<p class="v9-price" data-v9-price>{{ current.price | money }}</p>
{% form 'product', product, id: 'v9-buy-form', class: 'v9-buy-form' %}
{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ current.id }}">{% else %}
<label class="v9-variant">{{ 'v9.pp.option' | t }}<select name="id" data-v9-variant>{% for v in product.variants %}<option value="{{ v.id }}" data-price="{{ v.price | money | strip_html | escape }}"{% if v.id == current.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title | escape }}{% unless v.available %} — {{ 'v9.pp.soldout' | t }}{% endunless %}</option>{% endfor %}</select></label>{% endif %}
<div class="v9-buy"><div class="v9-qty" data-v9-qty role="group" aria-label="{{ 'v9.pp.qty' | t }}"><button type="button" aria-label="−">−</button><input type="number" name="quantity" value="1" min="1" aria-label="{{ 'v9.pp.qty' | t }}"><button type="button" data-inc aria-label="+">+</button></div>
<button class="v9-btn" type="submit" data-v9-add data-label="{{ 'v9.pp.add' | t }}" data-adding="{{ 'v9.pp.adding' | t }}" data-added="{{ 'v9.pp.added' | t }}" data-sold="{{ 'v9.pp.soldout' | t }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'v9.pp.add' | t }}{% else %}{{ 'v9.pp.soldout' | t }}{% endif %}</button></div>
{% endform %}
<script type="application/json" data-v9-variants>{{ product.variants | json }}</script>
<p class="v9-note" style="margin-top:12px">{{ 'v9.pp.shipping' | t }} <a class="v9-ul" style="font-size:12px" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/care">{{ 'v9.pp.size' | t }}</a></p>
<div class="v9-desc">{{ product.description }}</div>
<div class="v9-pp-links">
{% if pland != '' %}{%- capture lname -%}{{ la_zh }} {{ la_roman }}{%- endcapture -%}<a class="v9-link" href="{{ routes.collections_url }}/{{ pland }}">{{ 'v9.pp.landLink' | t: land: lname }}</a>{% endif %}
{% if pel != '' %}{%- capture eln -%}{{ 'v9.el.' | append: pel | append: '.name' | t }}{%- endcapture -%}{% if pel == 'wood' %}<a class="v9-link" href="{{ routes.collections_url }}/element-wood">{{ 'v9.pp.elementLink' | t: el: eln }}</a>{% endif %}{% if pel == 'fire' %}<a class="v9-link" href="{{ routes.collections_url }}/fire">{{ 'v9.pp.elementLink' | t: el: eln }}</a>{% endif %}{% if pel == 'earth' %}<a class="v9-link" href="{{ routes.collections_url }}/earth">{{ 'v9.pp.elementLink' | t: el: eln }}</a>{% endif %}{% if pel == 'metal' %}<a class="v9-link" href="{{ routes.collections_url }}/metal">{{ 'v9.pp.elementLink' | t: el: eln }}</a>{% endif %}{% if pel == 'water' %}<a class="v9-link" href="{{ routes.collections_url }}/water">{{ 'v9.pp.elementLink' | t: el: eln }}</a>{% endif %}{% endif %}
<a class="v9-link" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.pp.readingLink' | t }}</a>
</div>
</div>
</section>
<section class="v9-border-top" aria-labelledby="v9-also-h"><div class="v9-wrap" style="padding-top:88px;padding-bottom:96px">
<h2 id="v9-also-h" class="v9-h2" style="font-size:36px;margin-bottom:36px">{{ 'v9.pp.also' | t }}</h2>
<div class="v9-grid w280">{%- assign shown = 0 -%}{%- for card_product in collections.all.products -%}{%- if card_product.id != product.id and shown < 3 -%}{%- assign shown = shown | plus: 1 -%}{% render 'v9-card', card_product: card_product %}{%- endif -%}{%- endfor -%}</div>
</div></section>
</div>
{% schema %}{"name":"CATHORA v9 product","settings":[]}{% endschema %}