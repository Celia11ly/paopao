{%- assign land = '' -%}{%- assign elk = '' -%}
{%- case collection.handle -%}{%- when 'putuo' -%}{%- assign land = 'putuo' -%}{%- assign land_el = 'water' -%}{%- when 'lingyin' -%}{%- assign land = 'lingyin' -%}{%- assign land_el = 'wood' -%}{%- when 'jingshan' -%}{%- assign land = 'jingshan' -%}{%- assign land_el = 'wood' -%}{%- when 'tiantai' -%}{%- assign land = 'tiantai' -%}{%- assign land_el = 'earth' -%}{%- when 'emei' -%}{%- assign land = 'emei' -%}{%- assign land_el = 'metal' -%}{%- when 'element-wood' -%}{%- assign elk = 'wood' -%}{%- assign el_c = '#56634A' -%}{%- assign el_ch = '木' -%}{%- when 'fire' -%}{%- assign elk = 'fire' -%}{%- assign el_c = '#9E3B2C' -%}{%- assign el_ch = '火' -%}{%- when 'earth' -%}{%- assign elk = 'earth' -%}{%- assign el_c = '#8C6A43' -%}{%- assign el_ch = '土' -%}{%- when 'metal' -%}{%- assign elk = 'metal' -%}{%- assign el_c = '#6E6C66' -%}{%- assign el_ch = '金' -%}{%- when 'water' -%}{%- assign elk = 'water' -%}{%- assign el_c = '#2F3B45' -%}{%- assign el_ch = '水' -%}{%- endcase -%}
<div class="v9">
{%- if land != '' -%}
{%- case land -%}{%- when 'putuo' -%}{%- assign la_bg = "#E7EAEA" -%}{%- assign la_fg = "#2F3B45" -%}{%- assign la_p1 = "M86 140 C104 104 146 96 176 140" -%}{%- assign la_p2 = "M24 156 C54 148 74 164 104 156 C134 148 154 164 184 156 C214 148 234 164 258 156" -%}{%- assign la_cx = 196 -%}{%- assign la_cy = 92 -%}{%- assign la_zh = "普陀" -%}{%- assign la_roman = "Putuo" -%}{%- when 'lingyin' -%}{%- assign la_bg = "#ECE9E1" -%}{%- assign la_fg = "#272B24" -%}{%- assign la_p1 = "M56 128 L116 54 L144 88 L170 62 L228 128" -%}{%- assign la_p2 = "M34 152 C80 142 122 162 164 150 C206 140 236 156 258 148" -%}{%- assign la_cx = 210 -%}{%- assign la_cy = 52 -%}{%- assign la_zh = "灵隐" -%}{%- assign la_roman = "Lingyin" -%}{%- when 'jingshan' -%}{%- assign la_bg = "#EDE7DA" -%}{%- assign la_fg = "#5A4A3A" -%}{%- assign la_p1 = "M98 120 C98 160 182 160 182 120 Z" -%}{%- assign la_p2 = "M20 98 C70 72 110 86 150 62 C190 42 230 72 262 60" -%}{%- assign la_cx = 74 -%}{%- assign la_cy = 64 -%}{%- assign la_zh = "径山" -%}{%- assign la_roman = "Jingshan" -%}{%- when 'tiantai' -%}{%- assign la_bg = "#E4E2DA" -%}{%- assign la_fg = "#3E413A" -%}{%- assign la_p1 = "M40 148 L40 112 L92 112 L92 88 L146 88 L146 64 L208 64 L208 148" -%}{%- assign la_p2 = "M22 102 C62 92 92 106 130 98 C168 90 200 102 244 94" -%}{%- assign la_cx = 232 -%}{%- assign la_cy = 48 -%}{%- assign la_zh = "天台" -%}{%- assign la_roman = "Tiantai" -%}{%- when 'emei' -%}{%- assign la_bg = "#EFE9DC" -%}{%- assign la_fg = "#7A5A2E" -%}{%- assign la_p1 = "M40 138 C80 120 104 70 140 58 C176 70 200 120 240 138" -%}{%- assign la_p2 = "M20 160 C70 150 110 166 150 158 C190 150 228 162 262 156" -%}{%- assign la_cx = 140 -%}{%- assign la_cy = 30 -%}{%- assign la_zh = "峨眉" -%}{%- assign la_roman = "Emei" -%}{%- endcase -%}
{%- capture lnum -%}{{ 'v9.lands.' | append: land | append: '.num' | t }}{%- endcapture -%}
<nav class="v9-wrap v9-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'v9.ui.crumbHome' | t }}</a><span aria-hidden="true">/</span><a href="{{ routes.root_url }}#lands">{{ 'v9.ui.crumbLands' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ la_zh }} {{ la_roman }}</span></nav>
<div class="v9-land-hero" style="background:{{ la_bg }}"><span class="v9-land-vert" aria-hidden="true" style="color:{{ la_fg }}">{{ la_zh }}</span><svg viewBox="0 0 280 200" aria-hidden="true" focusable="false"><path d="{{ la_p1 }}" fill="none" stroke="{{ la_fg }}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="{{ la_p2 }}" fill="none" stroke="{{ la_fg }}" stroke-width="0.8" stroke-linecap="round" opacity="0.65"></path><circle cx="{{ la_cx }}" cy="{{ la_cy }}" r="3.6" fill="{{ la_fg }}"></circle></svg></div>
<section class="v9-wrap v9-land-title" aria-labelledby="v9-land-h"><div>
<p class="v9-eyebrow red" style="margin-bottom:20px">{{ 'v9.ui.crumbLands' | t }} · {{ 'v9.ui.chapter' | t: n: lnum }}</p>
<h1 id="v9-land-h" class="v9-land-h"><span class="z">{{ la_zh }}</span><span class="r">{{ la_roman }}</span></h1>
<p class="v9-land-subt">{{ 'v9.lands.' | append: land | append: '.subtitle' | t }}</p></div>
<dl class="v9-meta"><div><dt>{{ 'v9.ui.mIntention' | t }}</dt><dd>{{ 'v9.lands.' | append: land | append: '.intention' | t }}</dd></div><div><dt>{{ 'v9.ui.mElement' | t }}</dt><dd><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#{{ land_el }}">{{ 'v9.lands.' | append: land | append: '.element' | t }}</a></dd></div><div><dt>{{ 'v9.ui.mKnown' | t }}</dt><dd>{{ 'v9.lands.' | append: land | append: '.known' | t }}</dd></div></dl>
</section>
<article class="v9-article" aria-labelledby="v9-land-h">
<p class="lead">{{ 'v9.lands.' | append: land | append: '.lead' | t }}</p>
{%- capture s1 -%}{{ 'v9.lands.' | append: land | append: '.s1' | t }}{%- endcapture -%}{%- capture s2 -%}{{ 'v9.lands.' | append: land | append: '.s2' | t }}{%- endcapture -%}{%- capture s3 -%}{{ 'v9.lands.' | append: land | append: '.s3' | t }}{%- endcapture -%}
{% if s1 != blank %}<p class="p">{{ s1 }}</p>{% endif %}{% if s2 != blank %}<p class="p">{{ s2 }}</p>{% endif %}{% if s3 != blank %}<p class="p">{{ s3 }}</p>{% endif %}
<div class="rule" aria-hidden="true"></div><p class="close">{{ 'v9.lands.' | append: land | append: '.close' | t }}</p>
</article>
<section class="v9-tint" aria-labelledby="v9-lp-h"><div class="v9-wrap" style="padding-top:96px;padding-bottom:104px">
{%- capture lname -%}{{ la_zh }} {{ la_roman }}{%- endcapture -%}
<h2 id="v9-lp-h" class="v9-h2" style="font-size:clamp(30px,3.4vw,40px);margin-bottom:40px">{{ 'v9.ui.piecesFrom' | t: land: lname }}</h2>
{% if collection.products.size > 0 %}<div class="v9-grid w280" style="max-width:960px">{% for card_product in collection.products %}{% render 'v9-card', card_product: card_product %}{% endfor %}</div>
{% else %}<div class="v9-empty"><p class="v9-serif-p" style="margin:0;font-size:24px;color:var(--v9-ink)">{{ 'v9.ui.emptyH' | t }}</p><p class="v9-p" style="margin:12px 0 0">{{ 'v9.ui.emptyP' | t }}</p>{% capture nl %}{{ 'v9.ui.notify' | t }}{% endcapture %}{% render 'v9-newsletter', id: 'v9-news-land', tag: collection.handle, label: nl %}</div>{% endif %}
</div></section>
<section class="v9-wrap" style="padding-top:96px;padding-bottom:104px" aria-labelledby="v9-ol-h">
<div class="v9-row-head" style="margin-bottom:36px"><h2 id="v9-ol-h" class="v9-h2" style="font-size:36px">{{ 'v9.ui.otherLands' | t }}</h2><a class="v9-ul" href="{{ routes.root_url }}#lands">{{ 'v9.ui.back' | t }}</a></div>
<div class="v9-lands">{% unless land == 'putuo' %}{% render 'v9-land-card', land: 'putuo', wide: true %}{% endunless %}{% unless land == 'lingyin' %}{% render 'v9-land-card', land: 'lingyin', wide: true %}{% endunless %}{% unless land == 'jingshan' %}{% render 'v9-land-card', land: 'jingshan', wide: true %}{% endunless %}{% unless land == 'tiantai' %}{% render 'v9-land-card', land: 'tiantai', wide: true %}{% endunless %}{% unless land == 'emei' %}{% render 'v9-land-card', land: 'emei', wide: true %}{% endunless %}</div></section>
{%- elsif elk != '' -%}
{%- capture eln -%}{{ 'v9.el.' | append: elk | append: '.name' | t }}{%- endcapture -%}
<nav class="v9-wrap v9-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'v9.ui.crumbHome' | t }}</a><span aria-hidden="true">/</span><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.ui.nav2' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ eln }}</span></nav>
<section class="v9-wrap v9-elhero" aria-labelledby="v9-elc-h"><div style="display:flex;gap:36px;align-items:center;flex-wrap:wrap"><span class="o" aria-hidden="true" style="background:{{ el_c }}">{{ el_ch }}</span>
<div><p class="v9-eyebrow red">{{ 'v9.ui.elEyebrow' | t }}</p><h1 id="v9-elc-h" class="v9-h1" style="font-size:clamp(44px,5vw,60px)">{{ eln }}</h1><p class="v9-kw" style="color:{{ el_c }};font-size:14px">{{ 'v9.el.' | append: elk | append: '.kw' | t }}</p></div></div>
<div><p class="v9-serif-p" style="margin:0">{{ 'v9.el.' | append: elk | append: '.desc' | t }}</p><p class="v9-label" style="margin:22px 0 6px">{{ 'v9.eu.materials' | t }}</p><p style="margin:0;font-size:15px">{{ 'v9.el.' | append: elk | append: '.materials' | t }}</p>
<a class="v9-btn" style="margin-top:28px" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.ui.elCta' | t }} <span aria-hidden="true">→</span></a></div></section>
<section class="v9-wrap" style="padding-top:80px;padding-bottom:104px" aria-labelledby="v9-elp-h">
<h2 id="v9-elp-h" class="v9-h2" style="font-size:clamp(30px,3.4vw,40px);margin-bottom:40px">{{ 'v9.eu.piecesOf' | t: el: eln }}</h2>
{% if collection.products.size > 0 %}<div class="v9-grid w280">{% for card_product in collection.products %}{% render 'v9-card', card_product: card_product %}{% endfor %}</div>{% else %}<p class="v9-serif-p">{{ 'v9.eu.emptyP' | t }}</p>{% endif %}
</section>
{%- else -%}
<nav class="v9-wrap v9-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'v9.ui.crumbHome' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
<section class="v9-wrap v9-col-head"><h1 class="v9-h1">{% if collection.handle == 'all' %}{{ 'v9.ui.allPieces' | t }}{% else %}{{ collection.title | escape }}{% endif %}</h1>{% if collection.description != blank %}<div class="v9-p" style="max-width:640px;margin-top:16px">{{ collection.description }}</div>{% endif %}</section>
<section class="v9-wrap" style="padding-bottom:104px">{% paginate collection.products by 24 %}<div class="v9-grid w280">{% for card_product in collection.products %}{% render 'v9-card', card_product: card_product %}{% else %}<p class="v9-serif-p">{{ 'v9.ui.emptyH' | t }}</p>{% endfor %}</div>
{% if paginate.pages > 1 %}<nav class="v9-pages" aria-label="Pagination">{% if paginate.previous %}<a class="v9-ul" href="{{ paginate.previous.url }}">←</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a class="v9-ul" href="{{ paginate.next.url }}">→</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>
{%- endif -%}
</div>
{% schema %}{"name":"CATHORA v9 collection","settings":[]}{% endschema %}