<script type="application/json" id="v10-el-read">{% case request.locale.iso_code %}{% when 'en' %}{"colon": ": ", "title": "Born on a {sb} day", "dm": "Day master {stem} · {dmText}", "types": {"strong": "Strong type", "slightlyStrong": "Leaning strong", "slightlyWeak": "Leaning gentle", "weak": "Gentle type"}, "typeStrong": "Your energy runs full, like a river in flood — you don't lack strength, you need an outlet. Channel the surplus into talent, wealth and work, and fortune begins to move.", "typeWeak": "Your energy is inward and fine, like a lamp that wants more oil — you don't lack direction, you need nourishment. With support from mentors and allies, your fortune rises steadily.", "wheelH": "Your elemental balance", "dmTag": "You", "sheng": "feeds", "ke": "checks", "roles": {"same": ["", "Self"], "res": ["", "Support"], "out": ["", "Talent"], "wea": ["", "Wealth"], "off": ["", "Career"]}, "favH": "Elements that favour you", "favTag": "Favourable", "avoidH": "Elements to keep in check", "avoidTag": "Unfavourable", "rows": {"color": "Lucky colours", "dir": "Lucky directions", "num": "Lucky numbers", "mat": "Materials to wear"}, "fav": {"out": "Release your talent: give abundant energy an outlet, so ideas become work and expression.", "wea": "Reap the reward: put your strength to practical use, and turn it into results you can see.", "off": "Build your career: direction and structure turn your edge into achievement and standing.", "res": "Find support: like an elder, it nourishes you with learning, protection and good fortune.", "same": "Walk with allies: kindred energy gives you confidence and the will to act."}, "avoid": {"res": "Your energy is already full; more nourishment can mean overthinking, underdoing and digging in.", "same": "Too much of your own kind breeds rivalry and friction, and money slips away.", "out": "It drains your reserves, leaving you tired, anxious and stretched thin.", "wea": "Opportunity outweighs your strength — it arrives but is hard to hold, and pressure follows.", "off": "Outside pressure and constraint weigh heavily, leaving you tense and worn."}, "tipH": "A note", "summer": "Born in summer, your chart runs warm — time near water and keeping cool help you balance.", "winter": "Born in winter, your chart runs cold — sunlight and warmth help you balance.", "missFav": "Your chart has no {list} — and it happens to favour you, so it is well worth drawing close to.", "missOther": "Your chart has no {list} — it isn't one of your favourable elements, so its absence does no harm.", "sep": ", ", "dirs": {"wood": "East", "fire": "South", "earth": "South-west, North-east", "metal": "West", "water": "North"}, "colors": {"wood": "Green", "fire": "Red", "earth": "Yellow", "metal": "White", "water": "Blue"},"mat":{"wood":{{ 'v9.el.wood.materials' | t | json }},"fire":{{ 'v9.el.fire.materials' | t | json }},"earth":{{ 'v9.el.earth.materials' | t | json }},"metal":{{ 'v9.el.metal.materials' | t | json }},"water":{{ 'v9.el.water.materials' | t | json }}}}{% when 'ja' %}{"colon": "：", "title": "{sb}の日に生まれたあなた", "dm": "日主は{stem} · {dmText}", "types": {"strong": "身強タイプ", "slightlyStrong": "やや強タイプ", "slightlyWeak": "やや弱タイプ", "weak": "身弱タイプ"}, "typeStrong": "あなたのエネルギーは満ちあふれ、水量豊かな川のよう。力は足りている、必要なのは出口です。余る力を才能・財・仕事へ向ければ、運は自然にめぐり出します。", "typeWeak": "あなたのエネルギーは内に秘めた繊細なもの、油を足したい灯のよう。方向は見えている、必要なのは滋養です。貴人や仲間の支えを得れば、運は着実に上向きます。", "wheelH": "五行のバランス", "dmTag": "日主", "sheng": "生", "ke": "剋", "roles": {"same": ["比劫", "自分"], "res": ["印星", "貴人"], "out": ["食傷", "才能"], "wea": ["財星", "財"], "off": ["官殺", "仕事"]}, "favH": "あなたを助ける五行", "favTag": "喜用", "avoidH": "控えたい五行", "avoidTag": "忌", "rows": {"color": "ラッキーカラー", "dir": "ラッキー方位", "num": "ラッキーナンバー", "mat": "身につけたい素材"}, "fav": {"out": "才能を解き放つ：満ちた力に出口を与え、思いを作品や表現に変えます。", "wea": "実りを得る：力を実際に使い、目に見える成果に変えます。", "off": "仕事を成す：方向と規律を与え、鋭さを成果と名声に変えます。", "res": "貴人の助け：目上の人のようにあなたを養い、学び・庇護・良縁をもたらします。", "same": "仲間の支え：同じ気が寄り添い、自信と行動力をくれます。"}, "avoid": {"res": "すでに力は十分。さらに養われると、考えすぎて動けず、頑なになりがちです。", "same": "同類が多すぎると、張り合いや摩擦が生まれ、お金も散りやすくなります。", "out": "心身を消耗しやすく、疲れや不安、力不足を招きます。", "wea": "財が多く身が弱い。機会が来てもつかみきれず、重圧がついてきます。", "off": "外からの圧力や制約が重く、緊張や疲れがたまりやすくなります。"}, "tipH": "ひとこと", "summer": "夏生まれで命式は熱に傾きがち。水に親しみ、涼やかに過ごすとバランスが整います。", "winter": "冬生まれで命式は寒に傾きがち。日の光やぬくもりに親しむとバランスが整います。", "missFav": "あなたの八字には{list}がありません。ちょうど喜用なので、積極的に近づきましょう。", "missOther": "あなたの八字には{list}がありません。喜用ではないので、欠けていても差し支えありません。", "sep": "・", "dirs": {"wood": "東", "fire": "南", "earth": "南西・北東", "metal": "西", "water": "北"}, "colors": {"wood": "緑", "fire": "赤", "earth": "黄", "metal": "白", "water": "紺"},"mat":{"wood":{{ 'v9.el.wood.materials' | t | json }},"fire":{{ 'v9.el.fire.materials' | t | json }},"earth":{{ 'v9.el.earth.materials' | t | json }},"metal":{{ 'v9.el.metal.materials' | t | json }},"water":{{ 'v9.el.water.materials' | t | json }}}}{% when 'ko' %}{"colon": ": ", "title": "{sb}일에 태어난 당신", "dm": "일주 {stem} · {dmText}", "types": {"strong": "신강형", "slightlyStrong": "약간 신강형", "slightlyWeak": "약간 신약형", "weak": "신약형"}, "typeStrong": "당신의 에너지는 넘쳐흐르는 강물처럼 충만합니다. 힘이 부족한 것이 아니라 출구가 필요합니다. 넘치는 힘을 재능·재물·일로 이끌면 운이 자연스럽게 흐르기 시작합니다.", "typeWeak": "당신의 에너지는 안으로 깊고 섬세합니다. 기름을 더해야 할 등불처럼, 방향은 있으나 자양이 필요합니다. 귀인과 동료의 도움을 받으면 운이 차근차근 오릅니다.", "wheelH": "오행 에너지 분포", "dmTag": "일주", "sheng": "생", "ke": "극", "roles": {"same": ["비겁", "자아"], "res": ["인성", "귀인"], "out": ["식상", "재능"], "wea": ["재성", "재물"], "off": ["관살", "일"]}, "favH": "당신을 돕는 오행", "favTag": "희용", "avoidH": "절제할 오행", "avoidTag": "기신", "rows": {"color": "행운의 색", "dir": "행운의 방위", "num": "행운의 숫자", "mat": "지니면 좋은 소재"}, "fav": {"out": "재능을 펼치다: 넘치는 힘에 출구를 주어 생각을 작품과 표현으로 바꿉니다.", "wea": "결실을 거두다: 힘을 실제에 써서 눈에 보이는 성과로 바꿉니다.", "off": "일을 이루다: 방향과 규율을 주어 날카로움을 성취와 명성으로 바꿉니다.", "res": "귀인의 도움: 어른처럼 당신을 길러 배움·보호·좋은 인연을 가져옵니다.", "same": "동료의 지지: 같은 기운이 곁에서 자신감과 행동력을 줍니다."}, "avoid": {"res": "이미 힘이 충분한데 더 채워지면 생각만 많고 실행이 줄며 고집스러워지기 쉽습니다.", "same": "같은 기운이 지나치면 경쟁과 마찰이 생기고 재물이 흩어지기 쉽습니다.", "out": "심력을 과하게 소모해 피로·불안·무력감이 오기 쉽습니다.", "wea": "재물은 많은데 몸이 약해 기회가 와도 붙잡기 어렵고 압박이 따릅니다.", "off": "바깥의 압박과 제약이 무거워 긴장하고 지치기 쉽습니다."}, "tipH": "한마디", "summer": "여름에 태어나 명식이 뜨거운 편입니다. 물을 가까이하고 시원하게 지내면 균형에 도움이 됩니다.", "winter": "겨울에 태어나 명식이 차가운 편입니다. 햇볕과 따뜻함을 가까이하면 균형에 도움이 됩니다.", "missFav": "당신의 팔자에 없는 오행: {list}. 마침 희용이니 적극적으로 가까이하세요.", "missOther": "당신의 팔자에 없는 오행: {list}. 희용이 아니니 없어도 괜찮습니다.", "sep": "·", "dirs": {"wood": "동", "fire": "남", "earth": "남서·북동", "metal": "서", "water": "북"}, "colors": {"wood": "초록", "fire": "빨강", "earth": "노랑", "metal": "하양", "water": "남색"},"mat":{"wood":{{ 'v9.el.wood.materials' | t | json }},"fire":{{ 'v9.el.fire.materials' | t | json }},"earth":{{ 'v9.el.earth.materials' | t | json }},"metal":{{ 'v9.el.metal.materials' | t | json }},"water":{{ 'v9.el.water.materials' | t | json }}}}{% else %}{"colon": "：", "title": "{sb}日出生的你", "dm": "日主为{stem} · {dmText}", "types": {"strong": "身强型", "slightlyStrong": "偏强型", "slightlyWeak": "偏弱型", "weak": "身弱型"}, "typeStrong": "你的能量充沛，像一条丰水期的河——不缺力量，缺的是出口。把多余的能量引向才华、财富与事业，运势自然流转起来。", "typeWeak": "你的能量内敛而细腻，像一盏需要添油的灯——不缺方向，缺的是滋养。多得贵人与同伴扶持，运势便会稳稳升起。", "wheelH": "五行能量分布", "dmTag": "日主", "sheng": "生", "ke": "克", "roles": {"same": ["比劫", "自我"], "res": ["印星", "贵人"], "out": ["食伤", "才华"], "wea": ["财星", "财富"], "off": ["官杀", "事业"]}, "favH": "对你有利的五行", "favTag": "喜用", "avoidH": "宜少接触的五行", "avoidTag": "忌", "rows": {"color": "幸运颜色", "dir": "幸运方位", "num": "幸运数字", "mat": "宜佩材质"}, "fav": {"out": "释放才华：给充沛的能量一个出口，让想法变成作品与表达。", "wea": "收获财富：把力量用在实处，化为看得见的回报。", "off": "成就事业：为你定方向、立规矩，让锋芒化为成就与名望。", "res": "贵人相助：像长辈一样滋养你，带来学识、庇护与好机缘。", "same": "同伴扶持：同气相求，给你底气与行动力。"}, "avoid": {"res": "能量已足，再被滋养容易想得多、做得少，固执己见。", "same": "同类过多，容易争强好胜，人际有摩擦，钱财易散。", "out": "过度消耗心力，容易疲惫、焦虑、力不从心。", "wea": "财多身弱，机会来了却难以握住，压力随之而来。", "off": "外界的压力与约束偏重，容易紧绷、劳累。"}, "tipH": "小贴士", "summer": "你生于夏季，命局偏热——平日多亲近水、保持清凉，有助于平衡。", "winter": "你生于冬季，命局偏寒——平日多晒太阳、亲近温暖，有助于平衡。", "missFav": "你的八字中缺{list}，而它正好对你有利，值得多多亲近。", "missOther": "你的八字中缺{list}，它并非你的喜用，缺了反而无妨。", "sep": "、", "dirs": {"wood": "东", "fire": "南", "earth": "西南、东北", "metal": "西", "water": "北"}, "colors": {"wood": "青绿", "fire": "红紫", "earth": "黄棕", "metal": "白金", "water": "黑蓝"},"mat":{"wood":{{ 'v9.el.wood.materials' | t | json }},"fire":{{ 'v9.el.fire.materials' | t | json }},"earth":{{ 'v9.el.earth.materials' | t | json }},"metal":{{ 'v9.el.metal.materials' | t | json }},"water":{{ 'v9.el.water.materials' | t | json }}}}{% endcase %}</script>
