<span class="v10-land-img">{% if limg %}{{ limg | image_url: width: 900 | image_tag: loading: 'lazy', alt: la_roman, sizes: '(min-width: 900px) 30vw, 80vw', widths: '400,600,900' }}{% endif %}<span class="v10-land-chap">{{ 'v9.ui.chapter' | t: n: lnum }}</span><span class="v10-land-vert" aria-hidden="true">{{ la_zh }}</span></span>
<span class="v10-land-txt"><span class="v9-land-name"><span class="z">{{ la_zh }}</span><span class="r">{{ la_roman }}</span></span>
<span class="v9-land-sub">{{ 'v9.lands.' | append: lk | append: '.subtitle' | t }}</span>{% unless compact %}<span class="v9-land-leg">{{ 'v9.lands.' | append: lk | append: '.legend' | t }}</span>{% endunless %}</span>
</a>