{%- case land -%}{%- when 'putuo' -%}{%- assign lk = 'putuo' -%}{%- assign la_zh = '普陀' -%}{%- assign la_roman = 'Putuo' -%}{%- assign la_file = 'cathora-place-putuo.jpg' -%}{%- assign la_el = 'water' -%}{%- assign la_cra = 'Maeshima hiroki' -%}{%- assign la_crl = 'CC BY-SA 4.0' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:Puji_Temple_of_Mount_Putuo.jpg' -%}{%- when 'lingyin' -%}{%- assign lk = 'lingyin' -%}{%- assign la_zh = '灵隐' -%}{%- assign la_roman = 'Lingyin' -%}{%- assign la_file = 'cathora-place-lingyin.JPG' -%}{%- assign la_el = 'wood' -%}{%- assign la_cra = 'Sumple' -%}{%- assign la_crl = 'CC BY-SA 3.0' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:Lingyin_grotto.JPG' -%}{%- when 'jingshan' -%}{%- assign lk = 'jingshan' -%}{%- assign la_zh = '径山' -%}{%- assign la_roman = 'Jingshan' -%}{%- assign la_file = 'cathora-place-jingshan.jpg' -%}{%- assign la_el = 'wood' -%}{%- assign la_cra = 'Takashishin' -%}{%- assign la_crl = 'CC BY-SA 4.0' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:Jingshan_Temple.jpg' -%}{%- when 'tiantai' -%}{%- assign lk = 'tiantai' -%}{%- assign la_zh = '天台' -%}{%- assign la_roman = 'Tiantai' -%}{%- assign la_file = 'cathora-place-tiantai.jpg' -%}{%- assign la_el = 'earth' -%}{%- assign la_cra = 'Dahanbeige' -%}{%- assign la_crl = 'CC BY-SA 4.0' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:Guoqing_Temple%27s_Sui_Dynasty_Tower.jpg' -%}{%- when 'emei' -%}{%- assign lk = 'emei' -%}{%- assign la_zh = '峨眉' -%}{%- assign la_roman = 'Emei' -%}{%- assign la_file = 'cathora-place-emei.JPG' -%}{%- assign la_el = 'metal' -%}{%- assign la_cra = 'Mikael Häggström' -%}{%- assign la_crl = 'CC0' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:Guangfu_pavilion_at_Mount_Emei.JPG' -%}{%- when 'longmen' -%}{%- assign lk = 'longmen' -%}{%- assign la_zh = '龙门' -%}{%- assign la_roman = 'Longmen' -%}{%- assign la_file = 'cathora-place-longmen.jpg' -%}{%- assign la_el = 'earth' -%}{%- assign la_cra = 'Fanghong' -%}{%- assign la_crl = 'CC BY 2.5' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:DragonGateCave2.jpg' -%}{%- when 'white-horse' -%}{%- assign lk = 'whitehorse' -%}{%- assign la_zh = '白马' -%}{%- assign la_roman = 'White Horse' -%}{%- assign la_file = 'cathora-place-white-horse.jpg' -%}{%- assign la_el = 'metal' -%}{%- assign la_cra = 'Gary Todd' -%}{%- assign la_crl = 'CC0' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:2011-06_White_Horse_Temple_02.jpg' -%}{%- when 'wudang' -%}{%- assign lk = 'wudang' -%}{%- assign la_zh = '武当' -%}{%- assign la_roman = 'Wudang' -%}{%- assign la_file = 'cathora-place-wudang.jpg' -%}{%- assign la_el = 'fire' -%}{%- assign la_cra = 'Wikimedia Commons' -%}{%- assign la_crl = 'Public domain' -%}{%- assign la_cru = 'https://commons.wikimedia.org/wiki/File:Wudangshan_2003_10.jpg' -%}{%- endcase -%}{%- capture lnum -%}{{ 'v9.lands.' | append: lk | append: '.num' | t }}{%- endcapture -%}{%- assign limg = images[la_file] -%}
