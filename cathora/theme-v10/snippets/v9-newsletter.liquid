{%- assign nid = id | default: 'v9-news' -%}{% form 'customer', id: nid %}<input type="hidden" name="contact[tags]" value="newsletter{% if tag %},{{ tag }}{% endif %}">
<div class="v9-form-row"><label class="v9-sr" for="{{ nid }}-email">{{ 'v9.ui.email' | t }}</label><input class="v9-input" id="{{ nid }}-email" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'v9.ui.emailPh' | t }}"><button class="v9-btn" type="submit">{% if label %}{{ label }}{% else %}{{ 'v9.ui.subscribe' | t }}{% endif %}</button></div>
{% if form.posted_successfully? %}<p class="v9-status" role="status">{{ 'v9.ui.subscribed' | t }}</p>{% endif %}{{ form.errors | default_errors }}{% endform %}