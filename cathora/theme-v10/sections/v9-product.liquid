{%- assign pland = '' -%}{%- assign pel = '' -%}{%- assign is_bracelet = false -%}
{%- assign land_handles = "putuo lingyin jingshan tiantai emei longmen white-horse wudang" | split: ' ' -%}
{%- for c in product.collections -%}{%- if land_handles contains c.handle and pland == '' -%}{%- assign pland = c.handle -%}{%- endif -%}{%- if c.handle == 'bracelets' -%}{%- assign is_bracelet = true -%}{%- endif -%}{%- case c.handle -%}{%- when 'element-wood' -%}{%- assign pel = 'wood' -%}{%- when 'fire' -%}{%- assign pel = 'fire' -%}{%- when 'earth' -%}{%- assign pel = 'earth' -%}{%- when 'metal' -%}{%- assign pel = 'metal' -%}{%- when 'water' -%}{%- assign pel = 'water' -%}{%- endcase -%}{%- endfor -%}
{%- if pland != '' -%}{%- case pland -%}{%- when 'putuo' -%}{%- assign lk = 'putuo' -%}{%- assign la_zh = '普陀' -%}{%- assign la_roman = 'Putuo' -%}{%- assign la_file = 'cathora-photo-putuo.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'water' -%}{%- assign la_bg = '#E7EAEA' -%}{%- assign la_fg = '#2F3B45' -%}{%- assign la_p1 = 'M86 140 C104 104 146 96 176 140' -%}{%- assign la_p2 = 'M24 156 C54 148 74 164 104 156 C134 148 154 164 184 156 C214 148 234 164 258 156' -%}{%- assign la_cx = 196 -%}{%- assign la_cy = 92 -%}{%- when 'lingyin' -%}{%- assign lk = 'lingyin' -%}{%- assign la_zh = '灵隐' -%}{%- assign la_roman = 'Lingyin' -%}{%- assign la_file = 'cathora-photo-lingyin.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'wood' -%}{%- assign la_bg = '#ECE9E1' -%}{%- assign la_fg = '#272B24' -%}{%- assign la_p1 = 'M56 128 L116 54 L144 88 L170 62 L228 128' -%}{%- assign la_p2 = 'M34 152 C80 142 122 162 164 150 C206 140 236 156 258 148' -%}{%- assign la_cx = 210 -%}{%- assign la_cy = 52 -%}{%- when 'jingshan' -%}{%- assign lk = 'jingshan' -%}{%- assign la_zh = '径山' -%}{%- assign la_roman = 'Jingshan' -%}{%- assign la_file = 'cathora-photo-jingshan.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'wood' -%}{%- assign la_bg = '#EDE7DA' -%}{%- assign la_fg = '#5A4A3A' -%}{%- assign la_p1 = 'M98 120 C98 160 182 160 182 120 Z' -%}{%- assign la_p2 = 'M20 98 C70 72 110 86 150 62 C190 42 230 72 262 60' -%}{%- assign la_cx = 74 -%}{%- assign la_cy = 64 -%}{%- when 'tiantai' -%}{%- assign lk = 'tiantai' -%}{%- assign la_zh = '天台' -%}{%- assign la_roman = 'Tiantai' -%}{%- assign la_file = 'cathora-photo-tiantai.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'earth' -%}{%- assign la_bg = '#E4E2DA' -%}{%- assign la_fg = '#3E413A' -%}{%- assign la_p1 = 'M40 148 L40 112 L92 112 L92 88 L146 88 L146 64 L208 64 L208 148' -%}{%- assign la_p2 = 'M22 102 C62 92 92 106 130 98 C168 90 200 102 244 94' -%}{%- assign la_cx = 232 -%}{%- assign la_cy = 48 -%}{%- when 'emei' -%}{%- assign lk = 'emei' -%}{%- assign la_zh = '峨眉' -%}{%- assign la_roman = 'Emei' -%}{%- assign la_file = 'cathora-photo-emei.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'metal' -%}{%- assign la_bg = '#EFE9DC' -%}{%- assign la_fg = '#7A5A2E' -%}{%- assign la_p1 = 'M40 138 C80 120 104 70 140 58 C176 70 200 120 240 138' -%}{%- assign la_p2 = 'M20 160 C70 150 110 166 150 158 C190 150 228 162 262 156' -%}{%- assign la_cx = 140 -%}{%- assign la_cy = 30 -%}{%- when 'longmen' -%}{%- assign lk = 'longmen' -%}{%- assign la_zh = '龙门' -%}{%- assign la_roman = 'Longmen' -%}{%- assign la_file = 'cathora-photo-longmen.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'earth' -%}{%- assign la_bg = '#E9E6DE' -%}{%- assign la_fg = '#4A4238' -%}{%- assign la_p1 = 'M34 150 L34 66 C34 58 40 54 48 54 L232 54 C240 54 246 58 246 66 L246 150 M108 150 L108 106 C108 74 172 74 172 106 L172 150 M126 150 C126 132 154 132 154 150' -%}{%- assign la_p2 = 'M18 166 C60 158 96 172 140 164 C184 156 222 170 262 162' -%}{%- assign la_cx = 140 -%}{%- assign la_cy = 112 -%}{%- when 'white-horse' -%}{%- assign lk = 'whitehorse' -%}{%- assign la_zh = '白马' -%}{%- assign la_roman = 'White Horse' -%}{%- assign la_file = 'cathora-photo-white-horse.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'metal' -%}{%- assign la_bg = '#EEE7DC' -%}{%- assign la_fg = '#6E4A36' -%}{%- assign la_p1 = 'M124 150 L124 124 L156 124 L156 150 M114 124 L166 124 M118 108 L162 108 M122 94 L158 94 M126 82 L154 82 M130 72 L150 72 M140 72 L140 56' -%}{%- assign la_p2 = 'M24 150 L256 150 M40 150 C60 140 80 140 96 150' -%}{%- assign la_cx = 214 -%}{%- assign la_cy = 62 -%}{%- when 'wudang' -%}{%- assign lk = 'wudang' -%}{%- assign la_zh = '武当' -%}{%- assign la_roman = 'Wudang' -%}{%- assign la_file = 'cathora-photo-wudang.jpg' -%}{%- assign has_photo = false -%}{%- assign la_el = 'fire' -%}{%- assign la_bg = '#E7E7E2' -%}{%- assign la_fg = '#3A3F45' -%}{%- assign la_p1 = 'M26 150 L86 82 L114 112 L156 40 L198 104 L254 150 M148 44 L164 44 M150 40 L162 40' -%}{%- assign la_p2 = 'M36 126 C62 118 84 132 112 124 M168 134 C194 126 214 138 242 130' -%}{%- assign la_cx = 156 -%}{%- assign la_cy = 30 -%}{%- endcase -%}{%- endif -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- assign lc = request.locale.iso_code -%}{%- assign specs = product.metafields.custom.specs.value[lc] | default: product.metafields.custom.specs.value['en'] -%}
<script type="application/ld+json">{{ product | structured_data }}</script>
<div class="v9">
<nav class="v9-wrap v9-crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'v9.ui.crumbHome' | t }}</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">{{ 'v9.x.nav.shop' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span></nav>
<section class="v9-wrap v9-pp" aria-labelledby="v9-pp-h">
<div class="v9-gallery" data-v9-gallery>
<div class="v9-square">{%- assign fm = product.featured_media -%}{% if fm %}{{ fm | image_url: width: 1400 | image_tag: class: 'v9-main', loading: 'eager', fetchpriority: 'high', alt: product.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '600,900,1200,1400' }}{% endif %}</div>
{% if product.media.size > 1 %}<div class="v9-thumbs">{% for m in product.media %}{% if m.media_type == 'image' %}<button type="button" data-v9-thumb data-src="{{ m | image_url: width: 1400 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'v9.pp.image' | t }} {{ forloop.index }}">{{ m | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}</button>{% endif %}{% endfor %}</div>{% endif %}
</div>
<div class="v10-buybox">
<div class="v9-tags">{% if pland != '' %}<a href="{{ routes.collections_url }}/{{ pland }}">{{ 'v9.pp.land' | t }} · {{ la_zh }} {{ la_roman }}</a>{% endif %}{% if pel != '' %}<a href="{{ routes.collections_url }}/{% case pel %}{% when 'wood' %}element-wood{% when 'fire' %}fire{% when 'earth' %}earth{% when 'metal' %}metal{% when 'water' %}water{% endcase %}">{{ 'v9.pp.element' | t }} · {{ 'v9.el.' | append: pel | append: '.name' | t }}</a>{% endif %}</div>
<h1 id="v9-pp-h" class="v9-h1 v9-pp-title">{{ product.title | escape }}</h1>
<p class="v9-price" data-v9-price>{{ current.price | money }}</p>
<div class="v10-chips" style="margin-top:20px" aria-label="{{ 'v9.x.pdp.blessFor' | t }}">{% render 'v10-bless-chips', p: product %}</div>
{% form 'product', product, id: 'v9-buy-form', class: 'v9-buy-form' %}
<input type="hidden" name="id" value="{{ current.id }}">
{% if is_bracelet %}<label class="v9-variant">{{ 'v9.x.pdp.size' | t }}<select name="properties[Wrist size]"><option value="S 15cm">{{ 'v9.x.pdp.sizeS' | t }}</option><option value="M 16.5cm" selected>{{ 'v9.x.pdp.sizeM' | t }}</option><option value="L 18cm">{{ 'v9.x.pdp.sizeL' | t }}</option></select></label><p class="v10-help">{{ 'v9.x.pdp.sizeHelp' | t }} <a class="v9-ul" style="font-size:12px" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/care">{{ 'v9.pp.size' | t }}</a></p>{% endif %}
<div class="v9-buy"><div class="v9-qty" data-v9-qty role="group" aria-label="{{ 'v9.pp.qty' | t }}"><button type="button" aria-label="−">−</button><input type="number" name="quantity" value="1" min="1" aria-label="{{ 'v9.pp.qty' | t }}"><button type="button" data-inc aria-label="+">+</button></div>
<button class="v9-btn" type="submit" data-v9-add data-label="{{ 'v9.pp.add' | t }}" data-adding="{{ 'v9.pp.adding' | t }}" data-added="{{ 'v9.pp.added' | t }}" data-sold="{{ 'v9.pp.soldout' | t }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'v9.pp.add' | t }}{% else %}{{ 'v9.pp.soldout' | t }}{% endif %}</button></div>
{% endform %}
<ul class="v10-trust"><li>{{ 'v9.x.pdp.trust1' | t }}</li><li>{{ 'v9.x.pdp.trust2' | t }}</li><li>{{ 'v9.x.pdp.trust3' | t }}</li></ul>
<div class="v10-accs">
<details class="v10-acc" open><summary>{{ 'v9.x.pdp.tabStory' | t }}</summary><div class="v10-acc-b"><div class="v9-desc" style="margin:0;border:0;padding:0">{{ product.description }}</div></div></details>
{% if specs %}<details class="v10-acc"><summary>{{ 'v9.x.pdp.tabSpecs' | t }}</summary><div class="v10-acc-b"><table class="v10-specs">{% for row in specs %}<tr><th scope="row">{{ row[0] }}</th><td>{{ row[1] }}</td></tr>{% endfor %}</table></div></details>{% endif %}
<details class="v10-acc"><summary>{{ 'v9.x.pdp.tabShip' | t }}</summary><div class="v10-acc-b"><p>{{ 'v9.x.pdp.shipIntro' | t }}</p><table class="v10-ship"><thead><tr><th>{{ 'v9.x.pdp.shipRegion' | t }}</th><th>{{ 'v9.x.pdp.shipMethod' | t }}</th><th>{{ 'v9.x.pdp.shipTime' | t }}</th><th>{{ 'v9.x.pdp.shipCost' | t }}</th></tr></thead><tbody><tr><td>{{ 'v9.x.pdp.shipIntl' | t }}</td><td>{{ 'v9.x.pdp.shipStd' | t }}</td><td>{{ 'v9.x.pdp.shipIstd' | t }}</td><td>SGD 15<br><small>{{ 'v9.x.pdp.shipFree' | t }}</small></td></tr><tr><td>{{ 'v9.x.pdp.shipIntl' | t }}</td><td>{{ 'v9.x.pdp.shipExp' | t }}</td><td>{{ 'v9.x.pdp.shipIexp' | t }}</td><td>SGD 45</td></tr></tbody></table><p class="v10-help">{{ 'v9.x.pdp.shipIntlList' | t }}</p><p class="v10-help">{{ 'v9.x.pdp.shipNote' | t }}</p></div></details>
<details class="v10-acc"><summary>{{ 'v9.x.pdp.tabReturns' | t }}</summary><div class="v10-acc-b"><p>{{ 'v9.x.pdp.returns' | t }}</p></div></details>
<details class="v10-acc"><summary>{{ 'v9.x.pdp.tabCare' | t }}</summary><div class="v10-acc-b"><ol class="v10-ol"><li>{{ 'v9.x.pdp.care1' | t }}</li><li>{{ 'v9.x.pdp.care2' | t }}</li><li>{{ 'v9.x.pdp.care3' | t }}</li><li>{{ 'v9.x.pdp.care4' | t }}</li></ol></div></details>
<details class="v10-acc"><summary>{{ 'v9.x.pdp.tabBox' | t }}</summary><div class="v10-acc-b"><p>{{ 'v9.x.pdp.box' | t }}</p></div></details>
<details class="v10-acc"><summary>{{ 'v9.x.pdp.tabFaq' | t }}</summary><div class="v10-acc-b"><details class="v10-q"><summary>{{ 'v9.x.faq.q1.q' | t }}</summary><p>{{ 'v9.x.faq.q1.a' | t }}</p></details><details class="v10-q"><summary>{{ 'v9.x.faq.q2.q' | t }}</summary><p>{{ 'v9.x.faq.q2.a' | t }}</p></details><details class="v10-q"><summary>{{ 'v9.x.faq.q3.q' | t }}</summary><p>{{ 'v9.x.faq.q3.a' | t }}</p></details><details class="v10-q"><summary>{{ 'v9.x.faq.q4.q' | t }}</summary><p>{{ 'v9.x.faq.q4.a' | t }}</p></details></div></details>
</div>
<div class="v9-pp-links">
{% if pland != '' %}{%- capture lname -%}{{ la_zh }} {{ la_roman }}{%- endcapture -%}<a class="v9-link" href="{{ routes.collections_url }}/{{ pland }}">{{ 'v9.pp.landLink' | t: land: lname }}</a>{% endif %}
<a class="v9-link" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.pp.readingLink' | t }}</a>
</div>
</div>
</section>
{% if product.media.size > 1 %}<section class="v9-border-top v10-detail" aria-labelledby="v10-dh"><div class="v10-detail-in">
<p class="v9-eyebrow red" style="text-align:center">CATHORA</p><h2 id="v10-dh" class="v9-h2" style="text-align:center;font-size:clamp(30px,3.4vw,40px)">{{ 'v9.x.pdp.detailH' | t }}</h2><p class="v9-p" style="text-align:center;margin:10px 0 40px">{{ 'v9.x.pdp.detailP' | t }}</p>
{% for m in product.media offset: 1 %}{% if m.media_type == 'image' %}<figure class="v10-dimg">{{ m | image_url: width: 1600 | image_tag: loading: 'lazy', alt: m.alt, sizes: '(min-width: 1000px) 900px, 100vw', widths: '600,900,1200,1600' }}</figure>{% endif %}{% endfor %}
</div></section>{% endif %}
<section class="v9-border-top" aria-labelledby="v9-also-h"><div class="v9-wrap" style="padding-top:88px;padding-bottom:96px">
<h2 id="v9-also-h" class="v9-h2" style="font-size:36px;margin-bottom:36px">{{ 'v9.pp.also' | t }}</h2>
<div class="v9-grid w280">{%- assign shown = 0 -%}{%- for card_product in collections.all.products -%}{%- if card_product.id != product.id and shown < 4 -%}{%- assign shown = shown | plus: 1 -%}{% render 'v9-card', card_product: card_product %}{%- endif -%}{%- endfor -%}</div>
</div></section>
</div>
{% schema %}{"name":"CATHORA product","settings":[]}{% endschema %}