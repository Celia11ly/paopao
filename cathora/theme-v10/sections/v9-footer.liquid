<footer class="v9-footer v9"><div class="v9-wrap">
<div class="v9-footer-grid">
<div><a href="{{ routes.root_url }}" aria-label="CATHORA"><img src="{{ 'cathora-logo-v9.png' | asset_url }}" alt="CATHORA" width="640" height="340" loading="lazy"></a><p class="v9-p" style="font-size:13px;margin:14px 0 0">{{ 'v9.ui.note' | t }}</p></div>
<nav aria-label="{{ 'v9.x.nav.shop' | t }}"><span>{{ 'v9.x.nav.shop' | t }}</span><a href="{{ routes.all_products_collection_url }}">{{ 'v9.x.nav.all' | t }}</a><a href="{{ routes.collections_url }}/bracelets">{{ 'v9.x.nav.bracelets' | t }}</a><a href="{{ routes.collections_url }}/necklaces">{{ 'v9.x.nav.necklaces' | t }}</a><a href="{{ routes.collections_url }}/charms">{{ 'v9.x.nav.charms' | t }}</a><a href="{{ routes.collections_url }}/accessories">{{ 'v9.x.nav.accessories' | t }}</a><a href="{{ routes.root_url }}#blessings">{{ 'v9.x.nav.blessings' | t }}</a></nav>
<nav aria-label="{{ 'v9.ui.fDiscover' | t }}"><span>{{ 'v9.ui.fDiscover' | t }}</span><a href="{{ routes.root_url }}#lands">{{ 'v9.x.nav.lands' | t }}</a><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.x.nav.elements' | t }}</a><a href="{{ routes.collections_url }}/gifting">{{ 'v9.x.nav.gifting' | t }}</a></nav>
<nav aria-label="{{ 'v9.x.nav.story' | t }}"><span>{{ 'v9.x.nav.story' | t }}</span><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/brand">{{ 'v9.x.nav.brand' | t }}</a><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/founder">{{ 'v9.x.nav.founder' | t }}</a></nav>
<nav aria-label="{{ 'v9.ui.fHelp' | t }}"><span>{{ 'v9.ui.fHelp' | t }}</span><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/care">{{ 'v9.x.nav.care' | t }}</a><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/faq">{{ 'v9.x.nav.faq' | t }}</a>{% if shop.shipping_policy.url != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'v9.ui.fShipping' | t }}</a>{% endif %}<a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/contact">{{ 'v9.ui.fContact' | t }}</a></nav>
</div>
<div class="v9-footer-bottom"><p>{{ 'v9.ui.disclaimer' | t }}</p><span>© {{ "now" | date: "%Y" }} {{ shop.name | escape }}{% if shop.privacy_policy.url != blank %} · <a href="{{ shop.privacy_policy.url }}" style="color:inherit">{{ shop.privacy_policy.title }}</a>{% endif %}</span></div>
</div></footer>
{% schema %}{"name":"CATHORA footer","settings":[]}{% endschema %}