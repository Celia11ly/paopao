<header class="v9-header v9 v10-header">
<div class="v9-wrap v9-header-top">
<button class="v9-burger" type="button" data-v9-burger aria-controls="v9-mobile" aria-expanded="false" aria-label="{{ 'v9.ui.menu' | t }}">☰</button>
<span class="v9-header-note">{{ 'v9.ui.note' | t }}</span>
<a class="v9-logo" href="{{ routes.root_url }}" aria-label="CATHORA"><img src="{{ 'cathora-logo-v9.png' | asset_url }}" alt="CATHORA" width="640" height="340"></a>
<div class="v9-header-tools">{% render 'v9-localization', fid: 'v9-loc-top' %}<a class="v9-bag" href="{{ routes.cart_url }}">{{ 'v9.ui.bag' | t }} (<span data-v9-count>{{ cart.item_count }}</span>)</a></div>
</div>
<nav class="v10-nav" aria-label="CATHORA"><div class="v9-wrap v10-nav-in"><div class="v10-item has-panel"><a class="v10-top" href="{{ routes.all_products_collection_url }}">{{ 'v9.x.nav.shop' | t }} <span aria-hidden="true" class="v10-caret">⌄</span></a><div class="v10-panel"><div class="v9-wrap v10-panel-in">
