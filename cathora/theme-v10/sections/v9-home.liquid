<div class="v9">
{%- assign hero = section.settings.hero_product | default: all_products['enduring-form'] -%}
<section class="v9-wrap v9-hero" aria-labelledby="v9-hero-h"><div style="max-width:540px">
<p class="v9-eyebrow" style="margin-bottom:26px">{{ 'v9.ui.eyebrow' | t }}</p>
<h1 id="v9-hero-h" class="v9-h1 v9-pre">{{ 'v9.ui.h1' | t }}</h1>
<p class="v9-lede">{{ 'v9.ui.lede' | t }}</p>
<div class="v9-cta"><a class="v9-btn" href="{{ routes.all_products_collection_url }}">{{ 'v9.x.home.heroCta1' | t }} <span aria-hidden="true">→</span></a><a class="v9-link" href="#blessings">{{ 'v9.x.home.heroCta2' | t }}</a></div></div>
{% if hero != blank %}<figure class="v9-figure"><a class="v9-square" href="{{ hero.url }}">{{ hero.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: hero.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '600,900,1200,1400' }}</a>
<figcaption class="v9-figcap"><span>{{ hero.title | escape }}</span><span>{{ hero.price | money }} ↗</span></figcaption></figure>{% endif %}
</section>
<section id="blessings" class="v9-tint" aria-labelledby="v10-bless-h"><div class="v9-wrap" style="padding-top:88px;padding-bottom:96px">
<div class="v9-sec-head" style="margin-bottom:40px"><div><p class="v9-eyebrow red">{{ 'v9.x.home.blessEyebrow' | t }}</p><h2 id="v10-bless-h" class="v9-h2">{{ 'v9.x.home.blessH' | t }}</h2></div><p class="v9-p">{{ 'v9.x.home.blessP' | t }}</p></div>
{% render 'v10-bless-tiles' %}</div></section>
<section id="pieces" aria-labelledby="v9-pieces-h"><div class="v9-wrap v9-sec" style="padding-top:96px;padding-bottom:96px">
<div class="v9-row-head"><h2 id="v9-pieces-h" class="v9-h2">{{ 'v9.x.home.bestH' | t }}</h2><a class="v9-ul" href="{{ routes.all_products_collection_url }}">{{ 'v9.ui.piecesLink' | t }}</a></div>
<div class="v9-grid">{% for card_product in collections.all.products limit: 8 %}{% render 'v9-card', card_product: card_product %}{% endfor %}</div></div></section>
<section id="lands" class="v9-border-top" aria-labelledby="v10-lands-h"><div class="v9-wrap" style="padding-top:104px;padding-bottom:104px">
<div class="v9-sec-head" style="margin-bottom:44px"><div><p class="v9-eyebrow red">{{ 'v9.ui.landsEyebrow' | t }}</p><h2 id="v10-lands-h" class="v9-h2 v9-pre">{{ 'v9.x.home.landsH' | t }}</h2></div><p class="v9-p">{{ 'v9.x.home.landsP' | t }}</p></div>
{% render 'v10-lands-carousel' %}</div></section>
<section id="elements" class="v9-tint" aria-labelledby="v9-el-h"><div class="v9-wrap v9-sec"><div class="v9-two"><div style="max-width:500px">
<p class="v9-eyebrow red">{{ 'v9.ui.elEyebrow' | t }}</p><h2 id="v9-el-h" class="v9-h2 v9-pre">{{ 'v9.ui.elH' | t }}</h2><p class="v9-p" style="margin:26px 0 0">{{ 'v9.ui.elP' | t }}</p>
<a class="v9-btn" style="margin-top:34px" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements">{{ 'v9.ui.elCta' | t }} <span aria-hidden="true">→</span></a></div>
<div class="v9-el-grid"><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#wood"><span class="o" aria-hidden="true" style="color:#56634A">木</span><span class="n">{{ 'v9.el.wood.name' | t }}</span><span class="l">{{ 'v9.el.wood.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#fire"><span class="o" aria-hidden="true" style="color:#9E3B2C">火</span><span class="n">{{ 'v9.el.fire.name' | t }}</span><span class="l">{{ 'v9.el.fire.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#earth"><span class="o" aria-hidden="true" style="color:#8C6A43">土</span><span class="n">{{ 'v9.el.earth.name' | t }}</span><span class="l">{{ 'v9.el.earth.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#metal"><span class="o" aria-hidden="true" style="color:#6E6C66">金</span><span class="n">{{ 'v9.el.metal.name' | t }}</span><span class="l">{{ 'v9.el.metal.line' | t }}</span></a><a class="v9-el" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/five-elements#water"><span class="o" aria-hidden="true" style="color:#2F3B45">水</span><span class="n">{{ 'v9.el.water.name' | t }}</span><span class="l">{{ 'v9.el.water.line' | t }}</span></a></div></div></div></section>
<section id="story" aria-labelledby="v9-story-h"><div class="v9-wrap v9-sec"><div class="v9-two" style="gap:72px">
<div class="v9-story-art"><img src="{{ 'cathora-mark.png' | asset_url }}" alt="" loading="lazy"></div>
<div style="max-width:540px"><p class="v9-eyebrow">{{ 'v9.ui.storyEyebrow' | t }}</p><h2 id="v9-story-h" class="v9-h2 v9-pre" style="font-size:clamp(32px,3.8vw,44px);line-height:1.14">{{ 'v9.x.brand.teaserH' | t }}</h2>
<p class="v9-serif-p" style="margin:26px 0 0">{{ 'v9.x.brand.s1' | t }}</p><p class="v9-serif-p" style="margin:16px 0 0">{{ 'v9.x.brand.s2' | t }}</p>
<div style="display:flex;flex-wrap:wrap;gap:28px;margin-top:36px"><a class="v9-ul" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/brand">{{ 'v9.ui.storyL1' | t }}</a><a class="v9-ul" href="{{ routes.root_url | append: '/' | replace: '//', '/' }}pages/founder">{{ 'v9.ui.storyL2' | t }}</a></div></div></div></div></section>
<section class="v9-tint v9-promises" aria-label="CATHORA"><div class="v9-wrap"><div class="v9-promise"><b>{{ 'v9.x.prom.p1.t' | t }}</b><span>{{ 'v9.x.prom.p1.l' | t }}</span></div><div class="v9-promise"><b>{{ 'v9.x.prom.p2.t' | t }}</b><span>{{ 'v9.x.prom.p2.l' | t }}</span></div><div class="v9-promise"><b>{{ 'v9.x.prom.p3.t' | t }}</b><span>{{ 'v9.x.prom.p3.l' | t }}</span></div><div class="v9-promise"><b>{{ 'v9.x.prom.p4.t' | t }}</b><span>{{ 'v9.x.prom.p4.l' | t }}</span></div></div></section>
<section class="v9-news" aria-labelledby="v9-news-h"><div class="v9-news-in"><h2 id="v9-news-h" class="v9-h2" style="font-size:36px">{{ 'v9.ui.newsH' | t }}</h2><p class="v9-p" style="margin:14px 0 0">{{ 'v9.ui.newsP' | t }}</p>{% render 'v9-newsletter', id: 'v9-news-home' %}</div></section>
</div>
{% schema %}{"name":"CATHORA home","settings":[{"type":"product","id":"hero_product","label":"Hero product / 主推商品"}],"presets":[{"name":"CATHORA home"}]}{% endschema %}